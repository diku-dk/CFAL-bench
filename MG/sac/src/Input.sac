/* If you have filters, you don't need the whole quickselect
   business. */

module Input;
export {init};

import RNG: all;
use Array: all;
use StdIO: all;

inline
int[k] insert_ascending(int[k] indices, double[n] keys, int i, int size)
{
    pos = size - 1;
    while (pos >= 1 && keys[indices[pos - 1]] > keys[i]) {
        indices[pos] = indices[pos - 1];
        pos--;
    }
    indices[pos] = i;

    return indices;
}

inline
int[k] insert_descending(int[k] indices, double[n] keys, int i, int size)
{
    pos = size - 1;
    while (pos >= 1 && keys[indices[pos - 1]] < keys[i]) {
        indices[pos] = indices[pos - 1];
        pos--;
    }
    indices[pos] = i;

    return indices;
}

/* Returns the indices of the k largest numbers */
inline
int[k], int[k] largest_smallest(double[n] x, int k)
{
  /* Descending */
  largest  = genarray([k], 0);
  /* Ascending */
  smallest  = genarray([k], 0);

  for (i = 1; i < k; i++) {
    if (x[i] > x[largest[i - 1]]) {
        largest = insert_descending(largest, x, i, i);
    }
    if (x[i] < x[smallest[i - 1]]) {
        smallest = insert_ascending(smallest, x, i, i);
    }
  }

  for (i = k; i < n; i++) {
    if (x[i] > x[largest[k - 1]]) {
        largest = insert_descending(largest, x, i, k);
    }
    if (x[i] < x[smallest[k - 1]]) {
        smallest = insert_ascending(smallest, x, i, k);
    }
  }

  return (largest, smallest);
}

inline
int[3] col_maj(int k, int[3] shape)
{
  n0 = shape[0];
  n1 = shape[1];
  n2 = shape[2];
  /* k = k0 + k1 * n0 + k2 * n0 * n1 */
  return [k % n0, (k % (n0 * n1)) / n0, k / (n0 * n1)];
}

int[., .] col_maj(int[.] ks, int[3] shape)
{
  return {iv -> col_maj(ks[iv], shape)};
}

inline
double[.] LCG_array(ulong seed, int n)
{
  res = genarray([n], 0d);

  res[0] = tod(seed) * 0x1p-46;
  for (i = 1; i < n; i++) {
    random, seed = LCG(seed);
    res[i] = random;
  }

  return res;
}

double[., ., .] init(int n)
{
  shape = [n, n, n];
  result = genarray(shape, 0d);

  /* Probably fastest for CPU */
  random_values = {[k] -> LCG_array(LCG_skip(314159265ul, k * n * n + 1), 
                                    n * n) 
                       | [k] < [n]};
  random_values = reshape([n * n * n], random_values);

  largest, smallest = largest_smallest(random_values, 10);
  ones = col_maj(largest, shape);
  minusones = col_maj(smallest, shape);

  for (i = 0; i < 10; i++) {
    result[mod(ones[i] + 1, shape)] = 1d;
    result[mod(minusones[i] + 1, shape)] = -1d;
  }

  return result;
}

cabal-version:      2.4
name:               quickhull
version:            0.1.0.0

author:             Ivo Gabe de Wolff
maintainer:         i.g.dewolff@uu.nl


executable quickhull
  main-is:          Main.hs

  other-modules:
    Quickhull

  build-depends:    base >= 4.10,
                    accelerate == 1.4.0.0,
                    accelerate-llvm == 1.4.0.0,
                    accelerate-llvm-native == 1.4.0.0,
                    accelerate-llvm-ptx == 1.4.0.0,
                    accelerate-io,
                    criterion-measurement == 0.2.4.0,
                    bytestring
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options: -threaded -Wall
